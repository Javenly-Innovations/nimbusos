<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SudContentFrame">

        <FrameLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/app_store_checkbox_view"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/location_margin_left"
                        android:paddingRight="@dimen/content_margin_right"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true">

                        <CheckBox
                            android:id="@+id/app_store_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:clickable="false"
                            style="@style/SudCheckBox.Multiline" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_store_option"
                            android:textStyle="bold"
                            style="@style/SudCheckBox.Multiline" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/app_store_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="@dimen/location_margin_left"
                        android:paddingRight="@dimen/content_margin_right"
                        android:paddingTop="@dimen/content_margin_top"
                        android:text="@string/app_store_description"
                        style="@style/SudDescription" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>